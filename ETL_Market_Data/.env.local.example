SSI_CONSUMER_ID=your_ssi_consumer_id
SSI_CONSUMER_SECRET=your_ssi_consumer_secret
SSI_BASE_URL=https://fc-data.ssi.com.vn
SSI_STREAM_URL=https://fc-datahub.ssi.com.vn

GOOGLE_API_KEY=your_google_api_key
GOOGLE_API_KEYS=your_google_api_key_1,your_google_api_key_2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_DELAY_SECONDS=3
GEMINI_REQUESTS_PER_MINUTE=5

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ssi_market
AIRFLOW_POSTGRES_DB=airflow_meta
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_pass

APP_TIMEZONE=Asia/Ho_Chi_Minh
BOOTSTRAP_START_DATE=2024-01-01
REQUEST_DELAY_SECONDS=1.20
MAX_RETRIES=5
INTRADAY_RESOLUTION=1
INTRADAY_PAGE_SIZE=1000
TRACKED_SYMBOLS=ACB,BCM,BID,BVH,CTG,FPT,GAS,GVR,HDB,HPG,MBB,MSN,MWG,PLX,POW,SAB,SHB,SSB,SSI,STB

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin123
AIRFLOW_ADMIN_EMAIL=admin@example.com

GROQ_API_KEY=your_groq_api_key
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
GROQ_TIMEOUT_SECONDS=60
GROQ_RETRY_DELAY_SECONDS=2
GROQ_MODEL=llama-3.3-70b-versatile
NEWS_SUMMARIZER_PROVIDER=groq
NEWS_SUMMARIZER_MODEL=llama-3.3-70b-versatile
