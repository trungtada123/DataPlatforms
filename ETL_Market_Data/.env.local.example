GROQ_MAX_RETRIES=1

FINANCIAL_REPORTS_QDRANT_URL=http://localhost:6333
FINANCIAL_REPORTS_QDRANT_COLLECTION=bctc_chunks
FINANCIAL_REPORTS_EMBEDDING_MODEL=BAAI/bge-m3
